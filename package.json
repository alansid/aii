{
  "name": "aigile-switch",
  "version": "0.43.1",
  "private": true,
  "description": "人類與 AI 助手共用的協作群組（Aigile-Switch 復刻版）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "smoke": "node scripts/smoke.js",
    "cf:dev": "npx wrangler@4 dev",
    "cf:db:init": "npx wrangler@4 d1 execute aigile-switch --remote --file=src/schema.sql",
    "cf:deploy": "npx wrangler@4 deploy",
    "cf:db:migrate-files": "node scripts/migrate.js migrations/0002_files.sql",
    "test:files": "node scripts/files-test.js",
    "test:team": "node scripts/team-test.js",
    "cf:db:migrate-env": "node scripts/migrate.js migrations/0003_env.sql",
    "cf:db:migrate-decisions": "node scripts/migrate.js migrations/0004_decisions.sql",
    "cf:db:migrate-indexes": "node scripts/migrate.js migrations/0005_indexes.sql",
    "cf:db:migrate-avatar": "node scripts/migrate.js migrations/0006_avatar.sql",
    "cf:db:migrate-avatar-img": "node scripts/migrate.js migrations/0007_avatar_img.sql",
    "cf:db:migrate-cards": "node scripts/migrate.js migrations/0008_cards.sql",
    "test:cards": "node scripts/cards-test.js",
    "cf:db:migrate-card-decisions": "node scripts/migrate.js migrations/0009_decisions_cards.sql",
    "cf:db:migrate-suggestions": "node scripts/migrate.js migrations/0010_suggestions.sql",
    "cf:db:migrate-standby": "node scripts/migrate.js migrations/0011_standby.sql",
    "cf:db:migrate-projects": "node scripts/migrate.js migrations/0012_projects.sql",
    "test:projects": "node scripts/projects-test.js",
    "test:suggestions": "node scripts/suggestions-test.js",
    "test:state": "node scripts/state-test.js",
    "cf:db:migrate-ai-state": "node scripts/migrate.js migrations/0013_ai_state.sql",
    "cf:db:migrate-project-space": "node scripts/migrate.js migrations/0014_project_space.sql",
    "cf:db:migrate-isolation": "node scripts/migrate.js migrations/0015_isolation.sql"
  }
}
